# Database (ค่าตรงกับ docker-compose.yml สำหรับเครื่อง dev)
DATABASE_URL=postgresql://hub:hub_dev_password@127.0.0.1:5433/hub_acc
TEST_DATABASE_URL=postgresql://hub:hub_dev_password@127.0.0.1:5433/hub_acc_test

# API
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# Web: ที่อยู่ API ที่ Next.js จะ proxy /api/* ไปหา
API_INTERNAL_URL=http://127.0.0.1:4000

# Auth
# อีเมลที่ได้เป็น admin เมื่อ login ครั้งแรก คั่นด้วยจุลภาค
ADMIN_EMAILS=you@example.com
# ได้จาก Google Cloud Console
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# ใช้ login โดยไม่มี Google ระหว่างพัฒนาเท่านั้น ระบบจะไม่ยอมเริ่มถ้าเปิดใน production
AUTH_DEV_LOGIN=true

# เชื่อมบัญชีภายนอก
# สร้างด้วย: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Page Kit
ANTHROPIC_API_KEY=

# Facebook Page (Meta App)
# Valid OAuth Redirect URI: http://localhost:3000/api/connections/meta/callback
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0
# เมตริกของ Page รายวัน คั่นด้วยจุลภาค ตรวจกับเอกสาร Page Insights ล่าสุดเมื่ออัปเกรดเวอร์ชัน
META_INSIGHT_METRICS=page_media_view,page_total_media_view_unique,page_follows
