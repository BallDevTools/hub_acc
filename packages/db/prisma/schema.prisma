generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  member
}

enum OwnerStatus {
  active
  inactive
}

enum MailboxProvider {
  gmail
  workspace
  other
}

enum MailboxStatus {
  pending
  active
  issue
  disabled
}

enum Platform {
  shopee
  facebook
}

enum AccountStatus {
  not_started
  in_progress
  pending_review
  approved
  rejected
  suspended
}

enum PageStatus {
  draft
  active
  restricted
  archived
}

model User {
  id          String    @id @default(uuid()) @db.Uuid
  email       String    @unique
  name        String?
  role        UserRole  @default(member)
  active      Boolean   @default(true)
  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  sessions      Session[]
  managedOwners Owner[]
  auditLogs     AuditLog[]
  assignedTasks OnboardingTask[]
  shopeeImports ShopeeImport[]
  contentItems  ContentItem[] @relation("ContentCreator")
  approvedItems ContentItem[] @relation("ContentApprover")
  connections   OAuthConnection[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Owner {
  id           String      @id @default(uuid()) @db.Uuid
  name         String
  team         String?
  contactEmail String?     @map("contact_email")
  managerId    String?     @map("manager_id") @db.Uuid
  status       OwnerStatus @default(active)
  notes        String?
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  manager          User?             @relation(fields: [managerId], references: [id], onDelete: SetNull)
  mailboxes        Mailbox[]
  platformAccounts PlatformAccount[]
  pages            Page[]
  onboardingTasks  OnboardingTask[]
  pageKits         PageKit[]

  @@index([status])
  @@index([managerId])
  @@map("owners")
}

model Mailbox {
  id               String          @id @default(uuid()) @db.Uuid
  ownerId          String          @map("owner_id") @db.Uuid
  address          String          @unique
  provider         MailboxProvider @default(gmail)
  status           MailboxStatus   @default(pending)
  twoFactorEnabled Boolean         @default(false) @map("two_factor_enabled")
  vaultUrl         String?         @map("vault_url")
  notes            String?
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  owner            Owner             @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  platformAccounts PlatformAccount[]
  connection       OAuthConnection?
  emailEvents      EmailEvent[]

  @@index([ownerId])
  @@index([status])
  @@map("mailboxes")
}

model PlatformAccount {
  id              String        @id @default(uuid()) @db.Uuid
  ownerId         String        @map("owner_id") @db.Uuid
  mailboxId       String?       @map("mailbox_id") @db.Uuid
  platform        Platform
  displayName     String        @map("display_name")
  status          AccountStatus @default(not_started)
  statusReason    String?       @map("status_reason")
  statusChangedAt DateTime      @default(now()) @map("status_changed_at")
  vaultUrl        String?       @map("vault_url")
  notes           String?
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  owner   Owner    @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  mailbox Mailbox? @relation(fields: [mailboxId], references: [id], onDelete: Restrict)
  pages   Page[]
  emailEvents EmailEvent[]

  @@index([ownerId])
  @@index([mailboxId])
  @@index([platform, status])
  @@map("platform_accounts")
}

model Page {
  id                String     @id @default(uuid()) @db.Uuid
  ownerId           String     @map("owner_id") @db.Uuid
  platformAccountId String?    @map("platform_account_id") @db.Uuid
  name              String
  url               String?
  status            PageStatus @default(draft)
  metaPageId        String?    @unique @map("meta_page_id")
  // ใช้จับคู่ยอดจาก Shopee กับ Page
  subId             String?    @unique @map("sub_id")
  notes             String?
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  owner           Owner            @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  platformAccount PlatformAccount? @relation(fields: [platformAccountId], references: [id], onDelete: Restrict)
  connection      OAuthConnection?
  postJobs        PostJob[]
  metrics         MetricDaily[]

  @@index([ownerId])
  @@index([platformAccountId])
  @@index([status])
  @@map("pages")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  // null หมายถึงระบบเป็นผู้ทำรายการ เช่น Mail Watcher
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  // ไม่ผูก foreign key เพื่อให้ประวัติยังอยู่หลังลบข้อมูล
  entityId   String   @map("entity_id") @db.Uuid
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

enum TaskStatus {
  todo
  done
  skipped
}

enum PageKitStatus {
  pending
  ready
  failed
}

enum ConnectionProvider {
  google_gmail
  meta_user
  meta_page
}

enum ConnectionStatus {
  active
  needs_reauth
}

enum EmailClassification {
  approved
  rejected
  suspended
  unknown
}

enum EmailOutcome {
  applied
  needs_review
  dismissed
}

enum NotificationSeverity {
  info
  warning
  critical
}

model OnboardingTask {
  id          String     @id @default(uuid()) @db.Uuid
  ownerId     String     @map("owner_id") @db.Uuid
  template    String
  stepKey     String     @map("step_key")
  title       String
  description String?
  url         String?
  position    Int
  status      TaskStatus @default(todo)
  assigneeId  String?    @map("assignee_id") @db.Uuid
  dueAt       DateTime?  @map("due_at")
  completedAt DateTime?  @map("completed_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  owner    Owner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  assignee User? @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  @@unique([ownerId, template, stepKey])
  @@index([status, dueAt])
  @@index([assigneeId])
  @@map("onboarding_tasks")
}

model PageKit {
  id        String        @id @default(uuid()) @db.Uuid
  ownerId   String        @map("owner_id") @db.Uuid
  category  String
  audience  String?
  tone      String?
  status    PageKitStatus @default(pending)
  drafts    Json?
  error     String?
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  owner Owner @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt])
  @@map("page_kits")
}

model OAuthConnection {
  id              String             @id @default(uuid()) @db.Uuid
  provider        ConnectionProvider
  accountLabel    String             @map("account_label")
  mailboxId       String?            @unique @map("mailbox_id") @db.Uuid
  createdById     String             @map("created_by_id") @db.Uuid
  accessTokenEnc  String             @map("access_token_enc")
  refreshTokenEnc String?            @map("refresh_token_enc")
  expiresAt       DateTime?          @map("expires_at")
  scopes          String
  status          ConnectionStatus   @default(active)
  lastSyncAt      DateTime?          @map("last_sync_at")
  lastError       String?            @map("last_error")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  // Facebook Page ที่ token นี้ใช้โพสต์ได้
  pageId    String?      @unique @map("page_id") @db.Uuid
  page      Page?        @relation(fields: [pageId], references: [id], onDelete: Cascade)
  mailbox   Mailbox?     @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  createdBy User         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  events    EmailEvent[]

  @@index([provider, status])
  @@map("oauth_connections")
}

model EmailEvent {
  id                String              @id @default(uuid()) @db.Uuid
  connectionId      String              @map("connection_id") @db.Uuid
  mailboxId         String              @map("mailbox_id") @db.Uuid
  gmailMessageId    String              @map("gmail_message_id")
  fromAddress       String              @map("from_address")
  subject           String
  receivedAt        DateTime            @map("received_at")
  platform          Platform?
  classification    EmailClassification
  reason            String
  outcome           EmailOutcome
  platformAccountId String?             @map("platform_account_id") @db.Uuid
  resolvedAt        DateTime?           @map("resolved_at")
  createdAt         DateTime            @default(now()) @map("created_at")

  connection      OAuthConnection  @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  mailbox         Mailbox          @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  platformAccount PlatformAccount? @relation(fields: [platformAccountId], references: [id], onDelete: SetNull)

  @@unique([connectionId, gmailMessageId])
  @@index([outcome, receivedAt])
  @@map("email_events")
}

model Notification {
  id          String               @id @default(uuid()) @db.Uuid
  severity    NotificationSeverity @default(info)
  title       String
  body        String?
  link        String?
  // กันแจ้งเตือนเรื่องเดิมซ้ำ
  dedupeKey   String               @unique @map("dedupe_key")
  readAt      DateTime?            @map("read_at")
  deliveredAt DateTime?            @map("delivered_at")
  createdAt   DateTime             @default(now()) @map("created_at")

  @@index([readAt, createdAt])
  @@index([deliveredAt])
  @@map("notifications")
}

enum ContentStatus {
  draft
  approved
  archived
}

enum PostJobStatus {
  scheduled
  publishing
  published
  failed
  unknown
  cancelled
}

model ContentItem {
  id           String        @id @default(uuid()) @db.Uuid
  title        String
  body         String
  link         String?
  status       ContentStatus @default(draft)
  createdById  String        @map("created_by_id") @db.Uuid
  approvedById String?       @map("approved_by_id") @db.Uuid
  approvedAt   DateTime?     @map("approved_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  createdBy  User      @relation("ContentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy User?     @relation("ContentApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  postJobs   PostJob[]

  @@index([status, updatedAt])
  @@map("content_items")
}

model PostJob {
  id             String        @id @default(uuid()) @db.Uuid
  contentItemId  String        @map("content_item_id") @db.Uuid
  pageId         String        @map("page_id") @db.Uuid
  scheduledAt    DateTime      @map("scheduled_at")
  status         PostJobStatus @default(scheduled)
  attempts       Int           @default(0)
  nextAttemptAt  DateTime?     @map("next_attempt_at")
  externalPostId String?       @map("external_post_id")
  lastError      String?       @map("last_error")
  publishedAt    DateTime?     @map("published_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Restrict)
  page        Page        @relation(fields: [pageId], references: [id], onDelete: Restrict)

  // คอนเทนต์หนึ่งชิ้นโพสต์ลงแต่ละ Page ได้ครั้งเดียว
  @@unique([contentItemId, pageId])
  @@index([status, scheduledAt])
  @@index([pageId, scheduledAt])
  @@map("post_jobs")
}

model MetricDaily {
  pageId    String   @map("page_id") @db.Uuid
  date      DateTime @db.Date
  metric    String
  value     Float
  updatedAt DateTime @updatedAt @map("updated_at")

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@id([pageId, date, metric])
  @@index([date])
  @@map("metrics_daily")
}

model ShopeeImport {
  id               String   @id @default(uuid()) @db.Uuid
  fileName         String   @map("file_name")
  rowCount         Int      @map("row_count")
  insertedCount    Int      @map("inserted_count")
  updatedCount     Int      @map("updated_count")
  unchangedCount   Int      @map("unchanged_count")
  invalidCount     Int      @map("invalid_count")
  duplicateCount   Int      @map("duplicate_count")
  importedById     String   @map("imported_by_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  importedBy User @relation(fields: [importedById], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@map("shopee_imports")
}

model ShopeeConversion {
  orderId    String   @map("order_id")
  // คำสั่งซื้อหนึ่งมีได้หลายสินค้า ถ้าไฟล์ไม่มีรหัสสินค้าจะเป็นค่าว่าง
  itemKey    String   @default("") @map("item_key")
  subId      String?  @map("sub_id")
  orderedAt  DateTime @map("ordered_at")
  status     String
  amount     Decimal  @db.Decimal(14, 2)
  commission Decimal  @db.Decimal(14, 2)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@id([orderId, itemKey])
  @@index([orderedAt])
  @@index([subId, orderedAt])
  @@map("shopee_conversions")
}
