generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  member
}

enum OwnerStatus {
  active
  inactive
}

enum MailboxProvider {
  gmail
  workspace
  other
}

enum MailboxStatus {
  pending
  active
  issue
  disabled
}

enum Platform {
  shopee
  facebook
}

enum AccountStatus {
  not_started
  in_progress
  pending_review
  approved
  rejected
  suspended
}

enum PageStatus {
  draft
  active
  restricted
  archived
}

model User {
  id          String    @id @default(uuid()) @db.Uuid
  email       String    @unique
  name        String?
  role        UserRole  @default(member)
  active      Boolean   @default(true)
  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  sessions      Session[]
  managedOwners Owner[]
  auditLogs     AuditLog[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Owner {
  id           String      @id @default(uuid()) @db.Uuid
  name         String
  team         String?
  contactEmail String?     @map("contact_email")
  managerId    String?     @map("manager_id") @db.Uuid
  status       OwnerStatus @default(active)
  notes        String?
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  manager          User?             @relation(fields: [managerId], references: [id], onDelete: SetNull)
  mailboxes        Mailbox[]
  platformAccounts PlatformAccount[]
  pages            Page[]

  @@index([status])
  @@index([managerId])
  @@map("owners")
}

model Mailbox {
  id               String          @id @default(uuid()) @db.Uuid
  ownerId          String          @map("owner_id") @db.Uuid
  address          String          @unique
  provider         MailboxProvider @default(gmail)
  status           MailboxStatus   @default(pending)
  twoFactorEnabled Boolean         @default(false) @map("two_factor_enabled")
  vaultUrl         String?         @map("vault_url")
  notes            String?
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  owner            Owner             @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  platformAccounts PlatformAccount[]

  @@index([ownerId])
  @@index([status])
  @@map("mailboxes")
}

model PlatformAccount {
  id              String        @id @default(uuid()) @db.Uuid
  ownerId         String        @map("owner_id") @db.Uuid
  mailboxId       String?       @map("mailbox_id") @db.Uuid
  platform        Platform
  displayName     String        @map("display_name")
  status          AccountStatus @default(not_started)
  statusReason    String?       @map("status_reason")
  statusChangedAt DateTime      @default(now()) @map("status_changed_at")
  vaultUrl        String?       @map("vault_url")
  notes           String?
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  owner   Owner    @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  mailbox Mailbox? @relation(fields: [mailboxId], references: [id], onDelete: Restrict)
  pages   Page[]

  @@index([ownerId])
  @@index([mailboxId])
  @@index([platform, status])
  @@map("platform_accounts")
}

model Page {
  id                String     @id @default(uuid()) @db.Uuid
  ownerId           String     @map("owner_id") @db.Uuid
  platformAccountId String?    @map("platform_account_id") @db.Uuid
  name              String
  url               String?
  status            PageStatus @default(draft)
  notes             String?
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  owner           Owner            @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  platformAccount PlatformAccount? @relation(fields: [platformAccountId], references: [id], onDelete: Restrict)

  @@index([ownerId])
  @@index([platformAccountId])
  @@index([status])
  @@map("pages")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  // ไม่ผูก foreign key เพื่อให้ประวัติยังอยู่หลังลบข้อมูล
  entityId   String   @map("entity_id") @db.Uuid
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @map("created_at")

  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}
