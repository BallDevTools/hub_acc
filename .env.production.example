# คัดลอกเป็น .env.production แล้วตั้ง chmod 600 ห้าม commit ไฟล์จริง

# โดเมนที่ชี้มาที่เครื่องนี้ Caddy จะขอใบรับรอง HTTPS ให้
DOMAIN=hub.example.com
WEB_ORIGIN=https://hub.example.com

# openssl rand -hex 32
POSTGRES_PASSWORD=

ADMIN_EMAILS=you@example.com

# Google OAuth ใช้ทั้ง login และ Gmail
# redirect URI: https://โดเมน/api/auth/google/callback และ https://โดเมน/api/connections/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# openssl rand -base64 32
# ถ้ากุญแจหาย ต้องเชื่อม Gmail และ Facebook ใหม่ทั้งหมด เก็บสำรองแยกจากไฟล์ backup
TOKEN_ENCRYPTION_KEY=

ANTHROPIC_API_KEY=

# redirect URI: https://โดเมน/api/connections/meta/callback
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0
META_INSIGHT_METRICS=page_media_view,page_total_media_view_unique,page_follows

# แจ้งเตือนเข้า Slack หรือ Discord (ถ้าต้องการ)
NOTIFY_WEBHOOK_URL=

# URL จากบริการตรวจ heartbeat เช่น healthchecks.io
# ถ้าระบบไม่ ping ถึงเวลา บริการนั้นจะแจ้งเตือนคุณ
HEALTHCHECK_PING_URL=
BACKUP_PING_URL=

# ทุก 86400 วินาที เก็บไว้ 14 วัน
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP_DAYS=14
